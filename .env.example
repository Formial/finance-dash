# Copy to .env and fill in. Use the same cluster as the pharmacy dashboard.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/formial-pharmacy?retryWrites=true&w=majority
# Optional: only if the database isn't named in the URI above (default: formial-pharmacy)
# MONGODB_DB=formial-pharmacy

# Google sign-in (required on Vercel). Same OAuth client ID as the pharmacy dashboard;
# add this site's URL under "Authorized JavaScript origins" for that client.
GOOGLE_CLIENT_ID=
# Comma-separated emails that may sign in. Anyone else is refused.
ALLOWED_EMAILS=
# Long random string used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=
PORT=3000
